{
  "name": "@xesam/timer",
  "version": "1.0.0",
  "description": "cross-platform compensated timer primitives for browser, Node.js, and Mini Program runtimes",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "directories": {
    "src": "src",
    "test": "test"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "format": "prettier --write ./src ./test",
    "prepublishOnly": "npm run clean && npm run build",
    "build": "npm run clean && tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xesam/js-timer.git"
  },
  "keywords": [
    "timer",
    "countdown",
    "miniprogram",
    "compensation",
    "pause-resume"
  ],
  "author": "xesam",
  "email": "xesamguo@gmail.com",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/xesam/js-timer/issues"
  },
  "homepage": "https://github.com/xesam/js-timer#readme",
  "dependencies": {
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.1",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "rimraf": "latest",
    "tsup": "^8.5.0"
  }
}
